{
  "name": "cortico-world-gomoku",
  "version": "0.1.6",
  "author": "brong",
  "type": "module",
  "description": "Gomoku World with a standalone live board, game history and optional Renju forbidden moves",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 5,
    "displayName": "五子棋 · Gomoku"
  },
  "files": [
    "src",
    "public",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.1.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
